<div
	class="fluid-art"
	data-fluid-art
	role="img"
	aria-label="Crimson fluid flowing along a figure-eight path"
>
	<svg class="fluid-fallback" viewBox="0 0 800 520" aria-hidden="true">
		<defs>
			<linearGradient id="splash-red" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#ff263e" />
				<stop offset=".45" stop-color="#e1082c" />
				<stop offset="1" stop-color="#a60025" />
			</linearGradient>
			<linearGradient id="splash-highlight" x1="0" y1="0" x2=".7" y2="1">
				<stop offset="0" stop-color="#fff" stop-opacity=".85" />
				<stop offset=".5" stop-color="#ffaba4" stop-opacity=".54" />
				<stop offset="1" stop-color="#fff" stop-opacity="0" />
			</linearGradient>
			<filter id="splash-shadow" x="-.15" y="-.2" width="1.3" height="1.5">
				<feGaussianBlur in="SourceAlpha" stdDeviation="13" />
				<feOffset dy="16" />
				<feComponentTransfer>
					<feFuncA type="linear" slope=".28" />
				</feComponentTransfer>
				<feMerge>
					<feMergeNode />
					<feMergeNode in="SourceGraphic" />
				</feMerge>
			</filter>
		</defs>
		<path
			d="M400 260 C340 65 147 40 95 172 C46 295 251 470 400 260 C549 50 754 225 705 348 C653 479 460 455 400 260"
			fill="none"
			stroke="url(#splash-red)"
			stroke-width="62"
			stroke-linecap="round"
			filter="url(#splash-shadow)"
		/>
		<path
			d="M400 229 C340 86 173 68 123 172"
			fill="none"
			stroke="url(#splash-highlight)"
			stroke-linecap="round"
			stroke-width="7"
			opacity=".7"
		/>
		<path
			d="M100 165c-24-20-35-9-26 8 8 15 24 17 39 5"
			fill="none"
			stroke="url(#splash-red)"
			stroke-width="18"
			stroke-linecap="round"
		/>
		<path
			d="M702 349c26 21 38 8 27-9-9-13-25-14-39-2"
			fill="none"
			stroke="url(#splash-red)"
			stroke-width="14"
			stroke-linecap="round"
		/>
		<g fill="#e1082c">
			<circle cx="78" cy="129" r="10" />
			<circle cx="100" cy="105" r="6" />
			<circle cx="121" cy="81" r="4" />
			<circle cx="145" cy="65" r="3" />
			<circle cx="731" cy="368" r="8" />
			<circle cx="708" cy="395" r="5" />
			<circle cx="686" cy="418" r="3" />
			<circle cx="662" cy="439" r="2" />
			<circle cx="399" cy="258" r="9" />
			<circle cx="415" cy="248" r="5" />
			<circle cx="382" cy="272" r="4" />
		</g>
	</svg>
	<canvas class="fluid-canvas" data-fluid-canvas aria-hidden="true"></canvas>
</div>

<style>
	.fluid-art {
		position: absolute;
		z-index: 1;
		top: 11%;
		right: -7%;
		width: min(62vw, 900px);
		aspect-ratio: 1.54;
		pointer-events: none;
	}

	.fluid-fallback,
	.fluid-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.fluid-fallback {
		overflow: visible;
		filter: drop-shadow(0 22px 22px rgba(114, 20, 25, 0.18));
		transition: opacity 240ms ease;
	}

	.fluid-canvas {
		display: block;
		opacity: 0;
		transition: opacity 240ms ease;
	}

	.fluid-art.is-webgl-ready .fluid-fallback {
		opacity: 0;
	}

	.fluid-art.is-webgl-ready .fluid-canvas {
		opacity: 1;
	}

	@media (max-width: 760px) {
		.fluid-art {
			top: 51%;
			right: -36%;
			width: min(124vw, 650px);
			opacity: 0.78;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fluid-fallback,
		.fluid-canvas {
			transition: none;
		}
	}
</style>

<script>
	const track = document.querySelector<HTMLElement>(".hero-track");
	const artwork = document.querySelector<HTMLElement>("[data-fluid-art]");
	const canvas = document.querySelector<HTMLCanvasElement>("[data-fluid-canvas]");
	const progress = document.querySelector<HTMLElement>(".flow-progress");
	const progressFill = document.querySelector<HTMLElement>("#flow-progress-fill");

	if (track && artwork && canvas && progress && progressFill) {
		const loadFluidScene = () => {
			void import("../scripts/fluid-scene")
				.then(({ mountFluidScene }) =>
					mountFluidScene({ track, artwork, canvas, progress, progressFill }),
				)
				.catch((error: unknown) => {
					console.error("Could not load the fluid WebGL artwork.", error);
				});
		};

		window.addEventListener("scroll", loadFluidScene, { once: true, passive: true });
	}
</script>
