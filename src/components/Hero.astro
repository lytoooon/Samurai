---
import FluidArtwork from "./FluidArtwork.astro";
import SiteHeader from "./SiteHeader.astro";
---

<section class="hero-track" aria-label="LYTON — digital design and software engineering">
	<div class="hero-stage" id="top">
		<div class="paper-grain" aria-hidden="true"></div>
		<div class="hero-index" aria-hidden="true">
			<span>EST.</span>
			<span>MMXXVI</span>
		</div>

		<FluidArtwork />
		<SiteHeader />

		<div class="hero-copy">
			<p class="eyebrow"><span>01</span> DIGITAL PRACTICE <span class="eyebrow-divider">/</span> 2026</p>
			<h1 class="hero-title">LYTON<span class="title-period">.</span></h1>
			<h2 class="hero-heading">Thoughtful digital.<br />Made to move.</h2>
			<p class="hero-description">
				I shape clear, characterful digital experiences — from the first sketch to the final line of code.
			</p>
			<a class="hero-cta" href="mailto:hello@lyton.design">
				<span class="cta-mark" aria-hidden="true">↗</span>
				<span>HAVE A GOOD ONE IN MIND?</span>
			</a>
		</div>

		<div class="hero-footer">
			<div class="footer-caption">
				<span>UI / UX DESIGN</span>
				<span class="footer-cross" aria-hidden="true">✳</span>
				<span>SOFTWARE ENGINEERING</span>
			</div>
			<div class="scroll-cue">
				<span>SCROLL TO FEEL THE FLOW</span>
			</div>
		</div>

		<div
			class="flow-progress"
			role="progressbar"
			aria-label="Scroll-driven fluid animation"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="0"
		>
			<span class="flow-progress-fill" id="flow-progress-fill"></span>
		</div>
	</div>
</section>

<style>
	.hero-track {
		position: relative;
		height: 168svh;
	}

	.hero-stage {
		position: sticky;
		top: 0;
		height: 100svh;
		min-height: 600px;
		overflow: hidden;
		isolation: isolate;
		background: var(--paper);
	}

	.paper-grain {
		position: absolute;
		z-index: -1;
		inset: 0;
		pointer-events: none;
		background-image: radial-gradient(rgba(38, 33, 27, 0.22) 0.45px, transparent 0.55px);
		background-size: 4px 4px;
		opacity: 0.11;
	}

	.hero-index {
		position: absolute;
		top: 47%;
		left: 2.4%;
		display: flex;
		gap: 15px;
		color: var(--muted);
		font-size: 9px;
		letter-spacing: 0.12em;
		writing-mode: vertical-rl;
	}

	.hero-copy {
		position: absolute;
		z-index: 2;
		top: 22%;
		left: max(var(--gutter), 8%);
		width: min(74vw, 1050px);
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 0 0 19px 4px;
		color: var(--muted);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.19em;
	}

	.eyebrow > span:first-child {
		color: var(--red);
	}

	.eyebrow-divider {
		color: rgba(29, 27, 25, 0.35);
	}

	.hero-title {
		margin: 0 0 17px -0.07em;
		font-family: var(--display);
		font-size: clamp(126px, 22vw, 360px);
		font-weight: 400;
		letter-spacing: -0.085em;
		line-height: 0.88;
	}

	.title-period {
		color: var(--red);
	}

	.hero-heading {
		margin: 0;
		font-family: var(--display);
		font-size: clamp(32px, 3.7vw, 54px);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 1.24;
	}

	.hero-description {
		max-width: 440px;
		margin: 22px 0 0 2px;
		color: #5f5b55;
		font-size: 16px;
		line-height: 1.7;
	}

	.hero-cta {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		gap: 12px;
		margin-top: 21px;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.15em;
	}

	.cta-mark {
		display: grid;
		width: 31px;
		height: 31px;
		place-items: center;
		border: 1px solid var(--red);
		border-radius: 50%;
		color: var(--red);
		font-size: 15px;
		transition: transform 180ms ease;
	}

	.hero-cta:hover .cta-mark {
		transform: translate(3px, -3px);
	}

	.hero-footer {
		position: absolute;
		z-index: 2;
		right: var(--gutter);
		bottom: 35px;
		left: var(--gutter);
		display: flex;
		align-items: end;
		justify-content: space-between;
	}

	.footer-caption,
	.scroll-cue {
		display: flex;
		align-items: center;
		font-size: 8px;
		font-weight: 600;
		letter-spacing: 0.16em;
	}

	.footer-caption {
		gap: 13px;
		color: var(--muted);
	}

	.footer-cross {
		color: var(--red);
		font-size: 12px;
	}

	.scroll-cue {
		color: var(--muted);
	}

	.flow-progress {
		position: absolute;
		z-index: 4;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		background: rgba(211, 41, 32, 0.12);
	}

	.flow-progress-fill {
		display: block;
		width: 100%;
		height: 100%;
		transform: scaleX(0);
		transform-origin: left center;
		background: var(--red);
	}

	@media (min-width: 1600px) {
		.hero-copy {
			left: calc((100vw - 1440px) / 2 + 120px);
		}
	}

	@media (max-width: 760px) {
		.hero-track {
			height: 150svh;
		}

		.hero-stage {
			min-height: 560px;
		}

		.hero-index {
			display: none;
		}

		.hero-copy {
			top: 24%;
			left: var(--gutter);
			width: calc(100% - var(--gutter) * 2);
		}

		.eyebrow {
			margin-bottom: 18px;
			font-size: 8px;
			letter-spacing: 0.14em;
		}

		.hero-title {
			margin-bottom: 21px;
			font-size: clamp(92px, 24vw, 160px);
		}

		.hero-heading {
			max-width: 355px;
			font-size: clamp(30px, 7.8vw, 42px);
		}

		.hero-description {
			max-width: 310px;
			margin-top: 15px;
			font-size: 14px;
		}

		.hero-cta {
			margin-top: 15px;
			font-size: 8px;
		}

		.hero-footer {
			right: var(--gutter);
			bottom: 24px;
			left: var(--gutter);
		}

		.footer-caption,
		.scroll-cue {
			font-size: 7px;
			letter-spacing: 0.11em;
		}

		.footer-caption {
			gap: 7px;
		}

	}

	@media (max-width: 390px) {
		.hero-description {
			max-width: 270px;
		}

		.footer-caption {
			gap: 5px;
			font-size: 6px;
		}

		.scroll-cue {
			font-size: 6px;
		}
	}
</style>
